;; StructuralLab UI & Layout Settings
(
 (window-width  . 1050)
 (window-height . 950)
 
 ;; Proportions for: (Design-Pane Documentation-Pane Command-Pane)
 ;; Fractions prevent the "Inexact Integer" crash.
 (pane-proportions . (35/100 45/100 20/100))
 
 (min-height-design  . 150)
 (min-height-docs    . 300)
 (min-height-command . 180)

 (vp-origin-x . 525)
 (vp-origin-y . 300)
 (vp-scale    . 5.0)
)